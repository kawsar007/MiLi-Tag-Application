model Product {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  // Marketing copy + pricing breakdown, editable by admin via PATCH
  // /api/product. `priceCents` remains the single authoritative price used
  // for order calculations (see /api/orders) — it's kept in sync as
  // discountPriceCents ?? originalPriceCents whenever either is updated,
  // so existing checkout/order logic needs no changes.
  title              String?
  subtitle           String?  @db.Text
  priceCents         Int
  originalPriceCents Int?
  discountPriceCents Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders Order[]

  @@map("products")
}

model Order {
  id             String  @id
  customerName   String
  phone          String
  address        String  @db.Text
  district       String?
  quantity       Int     @default(1)
  unitPriceCents Int
  totalCents     Int

  deliveryArea        String @default("inside_dhaka")
  deliveryChargeCents Int    @default(8000)
  grandTotalCents     Int    @default(0) // totalCents + deliveryChargeCents

  note   String?     @db.Text
  status OrderStatus @default(PENDING)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@map("orders")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admins")
}
